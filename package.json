{
  "name": "wall-alankar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "test": "node --test worker/test/*.test.js",
